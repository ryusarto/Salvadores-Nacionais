{
  "name": "salvadores-nacionais",
  "version": "1.0.0",
  "description": "Salvadores Nacionais — jogo de luta",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "build": "node tools/build.mjs --external-assets --min",
    "dev": "node tools/build.mjs --serve",
    "test:browser": "npm run build && node tools/smoke-browser.mjs",
    "check:campaign": "node tools/campaign-check.mjs",
    "art:zanata": "node tools/import-zanata.mjs && node tools/zanata-preview.mjs",
    "test:zanata": "npm run build && node tools/smoke-zanata.mjs",
    "test:pavanassi": "npm run build && node tools/smoke-pavanassi.mjs",
    "test:fujao": "npm run build && node tools/smoke-fujao.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryusarto/salvadores-nacionais.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryusarto/salvadores-nacionais/issues"
  },
  "homepage": "https://github.com/ryusarto/salvadores-nacionais#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "1.56.1",
    "sharp": "^0.35.5"
  },
  "type": "module",
  "private": true
}
